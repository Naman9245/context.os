# Copy to backend/.env and edit. Every value is optional.

# Folders ContextOS scans for new files (comma-separated).
WATCH_DIRS=~/Downloads
# Where organised files go: LIBRARY_ROOT/<Semester>/<Subject>/<Type>/
LIBRARY_ROOT=~/ContextOS
# ContextOS's own database and cache.
DATA_DIR=~/.contextos

# LLM: none | gemini | groq. "none" = heuristics only, nothing leaves your machine.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Characters of each document sent to the LLM (never the whole file).
LLM_SNIPPET_CHARS=1500
