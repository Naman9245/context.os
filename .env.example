# Copy to backend/.env and edit. Every value is optional.

# Folders ContextOS scans for new files (comma-separated).
WATCH_DIRS=~/Downloads
# Scan automatically when a new file lands in WATCH_DIRS.
WATCH_ENABLED=true
# Where organised files go: LIBRARY_ROOT/<Semester>/<Subject>/<Type>/
LIBRARY_ROOT=~/ContextOS
# ContextOS's own database and cache.
DATA_DIR=~/.contextos
# How to read dates like 04/05/2026 in your documents: DMY (4 May) or MDY (April 5).
DATE_ORDER=DMY

# LLM: none | gemini | groq. "none" = rules only, nothing leaves your machine.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used when the main model is busy or retired.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Characters of each document sent to the LLM (never the whole file).
LLM_SNIPPET_CHARS=1500
# Stay under the free tier's requests-per-minute limit.
LLM_REQUESTS_PER_MINUTE=10
