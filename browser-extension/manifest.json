{
  "manifest_version": 3,
  "name": "Khushi for Chrome",
  "description": "Lets Khushi (ContextOS) reuse her own tab for each site, and open the first result when you say \"open it\".",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://www.youtube.com/*",
    "https://www.google.com/*",
    "https://*.wikipedia.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "116"
}
